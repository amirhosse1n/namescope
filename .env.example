# Optional GitHub token. Public user lookup does not require special scopes.
GITHUB_TOKEN=

# Optional Telegram user API credentials for definitive account.checkUsername checks.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# App overrides.
NAMESCOPE_HOST=127.0.0.1
NAMESCOPE_PORT=8765
NAMESCOPE_OPEN_BROWSER=true
NAMESCOPE_RELOAD=false
NAMESCOPE_ALLOW_REMOTE=false
NAMESCOPE_LOG_LEVEL=INFO
# NAMESCOPE_DATABASE=/absolute/path/to/namescope.sqlite3
# NAMESCOPE_CONFIG=/absolute/path/to/config.yaml
